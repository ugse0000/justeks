# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/justeks
DB_USER=justeks
DB_PASSWORD=justeks_dev

# --- Admin console (HTTP Basic, Phase 1) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# --- File uploads (Sourcing Desk reference files) ---
UPLOAD_DIR=./uploads

# --- CORS: origins allowed to call the API ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- SMTP: not used in Phase 1. NotificationService logs instead.
# Fill these in and the SmtpNotificationService bean takes over.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SALES_NOTIFICATION_RECIPIENT=
